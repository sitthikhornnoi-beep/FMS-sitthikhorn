# ─────────────────────────────────────────────────────────────
# FMS Production Environment Configuration
# คัดลอกไฟล์นี้เป็น .env.production หรือ .env ก่อนรัน docker compose up
# ─────────────────────────────────────────────────────────────

# ฐานข้อมูล PostgreSQL สำหรับ Docker
DB_USER=postgres
DB_PASSWORD=your-super-strong-db-password-here
DB_NAME=ums_prod

# คีย์ความปลอดภัยสำหรับ NextAuth Session (ต้องเป็น base64 สุ่มขนาดอย่างน้อย 32 ไบต์)
# สร้างได้ด้วยคำสั่ง: openssl rand -base64 32
AUTH_SECRET=your-random-32-byte-base64-secret-here

# URL ของระบบสำหรับ Production
APP_URL=http://localhost:3010

# การตั้งค่าการส่งอีเมล (SMTP) - ถ้าเว้นว่างจะเขียนลง Log แทน
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=App <no-reply@example.com>

# การตั้งค่า OAuth (ไม่บังคับ - ถ้าเว้นว่างจะไม่แสดงปุ่ม)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ข้อมูลผู้ดูแลระบบสูงสุดเริ่มต้น (Super Admin) สำหรับการรัน docker compose exec web npm run db:bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=YourStrongAdminPassword123!
BOOTSTRAP_TENANT_CODE=DEFAULT
BOOTSTRAP_TENANT_NAME_TH=คณะการจัดการ มหาวิทยาลัย
BOOTSTRAP_TENANT_NAME_EN=Faculty of Management Sciences
